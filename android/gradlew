# Attempt to set APP_HOME
app_path=$0
while [ -h "$app_path" ] ; do
    ls=`ls -ld "$app_path"`
    link=`expr "$ls" : '.*-> \(.*\)$'`
    if expr "$link" : '/.*' > /dev/null; then
        app_path="$link"
    else
        app_path=`dirname "$app_path"`"/$link"
    fi
done

APP_BASE_NAME=`basename "$0"`
APP_HOME=`cd "\`dirname \"$app_path\"\`" >/dev/null && pwd`

MAX_FD=maximum

warn () {
    echo "$*"
} >&2

die () {
    echo
    echo "$*"
    echo
    exit 1
} >&2

# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        JAVACMD=$JAVA_HOME/jre/sh/java
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME"
    fi
else
    JAVACMD=java
    if ! command -v java >/dev/null 2>&1 ; then
        die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH."
    fi
fi

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

# If wrapper jar is not present:
if [ ! -f "$CLASSPATH" ]; then
    # If gradle is already installed on the system (e.g. GitHub Actions setup-gradle), use it directly
    if command -v gradle >/dev/null 2>&1; then
        exec gradle "$@"
    fi

    # Otherwise download gradle-wrapper.jar
    WRAPPER_JAR_URL="https://raw.githubusercontent.com/gradle/gradle/v8.9.0/gradle/wrapper/gradle-wrapper.jar"
    mkdir -p "$(dirname "$CLASSPATH")"
    if command -v curl >/dev/null 2>&1; then
        curl -sSL "$WRAPPER_JAR_URL" -o "$CLASSPATH" 2>/dev/null || true
    elif command -v wget >/dev/null 2>&1; then
        wget -q "$WRAPPER_JAR_URL" -O "$CLASSPATH" 2>/dev/null || true
    fi

    # If download failed or still missing, try system gradle or error
    if [ ! -f "$CLASSPATH" ]; then
        if command -v gradle >/dev/null 2>&1; then
            exec gradle "$@"
        else
            die "ERROR: Could not find or download gradle-wrapper.jar and gradle is not on PATH."
        fi
    fi
fi

# Increase the maximum file descriptors if we can.
if [ `uname` != "CYGWIN" ] && [ `uname` != "Darwin" ]; then
    MAX_FD_LIMIT=`ulimit -H -n`
    if [ $? -eq 0 ] ; then
        if [ "$MAX_FD" = "maximum" -o "$MAX_FD" = "max" ] ; then
            MAX_FD="$MAX_FD_LIMIT"
        fi
        ulimit -n $MAX_FD 2>/dev/null || true
    fi
fi

exec "$JAVACMD" "-Dorg.gradle.appname=$APP_BASE_NAME" -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
